instance Numeric Real where
  source Cpp from "core.hpp"
    ( "morloc_inv" as inv
    , "morloc_div" as (/)
    , "morloc_exp" as (**)
    , "morloc_log" as log
    )
  one = 1.0

instance Numeric Float32 where
  source Cpp from "core.hpp"
    ( "morloc_inv" as inv
    , "morloc_div" as (/)
    , "morloc_exp" as (**)
    , "morloc_log" as log
    )
  one = 1.0

