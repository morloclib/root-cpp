module root-cpp (*)

import root

type Cpp => Unit = "mlc::Unit" -- this is an enum with a single element, NOT `void`, which corresponds to bottom
type Cpp => Real = "double"
type Cpp => Int = "int"
type Cpp => Str = "std::string"
type Cpp => Bool = "bool"
type Cpp => (List a) = "std::vector<$1>" a
type Cpp => (Vector a) = "std::vector<$1>" a
type Cpp => (Array a) = "std::vector<$1>" a
type Cpp => (Deque a) = "std::deque<$1>" a
type Cpp => (Tuple2 a b) = "std::tuple<$1,$2>" a b
type Cpp => (Tuple3 a b c) = "std::tuple<$1,$2,$3>" a b c
type Cpp => (Tuple4 a b c d) = "std::tuple<$1,$2,$3,$4>" a b c d
type Cpp => (Tuple5 a b c d e) = "std::tuple<$1,$2,$3,$4,$5>" a b c d e
type Cpp => (Tuple6 a b c d e f) = "std::tuple<$1,$2,$3,$4,$5,$6>" a b c d e f
type Cpp => (Tuple7 a b c d e f g) = "std::tuple<$1,$2,$3,$4,$5,$6,$7>" a b c d e f g
type Cpp => (Tuple8 a b c d e f g h) = "std::tuple<$1,$2,$3,$4,$5,$6,$7,$8>" a b c d e f g h

type Cpp => Float64 = "double"
type Cpp => Float32 = "float"
type Cpp => Int8    = "int8_t"
type Cpp => Int16   = "int16_t"
type Cpp => Int32   = "int32_t"
type Cpp => Int64   = "int64_t"
type Cpp => UInt8   = "uint8_t"
type Cpp => UInt16  = "uint16_t"
type Cpp => UInt32  = "uint32_t"
type Cpp => UInt64  = "uint64_t"

-- used to force C++ usage, mostly in testing
idcpp a :: a -> a

source Cpp from "core.hpp"
    ( "morloc_id" as idcpp
    , "morloc_branch" as branch
    , "morloc_not" as not
    , "morloc_and" as (&&)
    , "morloc_or" as (||)
    , "morloc_zipWith" as zipWith
    , "morloc_reverse" as reverse
    , "morloc_sort" as sort
    , "morloc_sortBy" as sortBy
    , "morloc_filter" as filter
    , "morloc_unzip" as unzip
    , "morloc_replicate" as replicate
    , "morloc_takeWhile" as takeWhile
    , "morloc_dropWhile" as dropWhile
    , "morloc_partition" as partition
    , "morloc_scanl" as scanl
    , "morloc_enumerate" as enumerate
    , "morloc_intersperse" as intersperse
    , "morloc_iterate" as iterate
    , "morloc_groupBy" as groupBy
    , "morloc_find" as find
    , "morloc_unique" as unique
    , "morloc_groupSort" as groupSort
    , "morloc_range" as range
    , "morloc_rangeStep" as rangeStep
    , "morloc_toDeque" as toDeque
    , "morloc_toVector" as toVector
    , "morloc_toArray" as toArray
    )

instance Eq a where
  source Cpp from "core.hpp" ("morloc_eq" as (==))

instance Ord a where
  source Cpp from "core.hpp" ("morloc_le" as (<=))

instance Integral Int where
                , Int8
                , Int16
                , Int32
                , Int64
                , UInt8
                , UInt16
                , UInt32
                , UInt64
                , Real
                , Float32
                , Float64
  %inline source Cpp from "core.hpp"
    ( "morloc_neg" as neg
    , "morloc_abs" as abs
    , (+)
    , (-)
    , (*)
    , (//)
    , (%)
    )
  zero = 0

instance Integral Float32
                , Float64
  %inline source Cpp from "core.hpp"
    ( "morloc_neg" as neg
    , "morloc_abs" as abs
    , (+)
    , (-)
    , (*)
    , "morloc_floor_div" as (//)
    , "morloc_float_mod" as (%)
    , "morloc_pow" as (**)
    )
  zero = 0

instance Numeric Real
               , Float32
               , Float64 where
  %inline source Cpp from "core.hpp"
    ( "morloc_inv" as inv
    , "morloc_ln" as ln
    , (/)
    )

instance Semigroup Str where
  source Cpp from "core.hpp" ("morloc_add" as (<>))

instance Monoid Str where
  mempty = ""

instance Semigroup (List a) where
  source Cpp from "core.hpp" ("morloc_list_add" as (<>))

instance Monoid (List a) where
  mempty = []


-- List instances
instance Foldable List where
  source Cpp from "core.hpp"
    ( "morloc_fold" as fold
    , "morloc_fold1" as fold1
    , "morloc_safeFold1" as safeFold1
    )

instance Functor List where
  source Cpp from "core.hpp" ("morloc_map" as map)

instance Indexed List where
  source Cpp from "core.hpp"
    ( "morloc_at" as at
    , "morloc_slice" as slice
    )

instance Stack List where
  source Cpp from "core.hpp"
    ( "morloc_cons" as cons
    , "morloc_uncons" as uncons
    )

instance Queue List where
  source Cpp from "core.hpp"
    ( "morloc_snoc" as snoc
    , "morloc_unsnoc" as unsnoc
    )


-- Deque instances
instance Foldable Deque where
  source Cpp from "core.hpp"
    ( "morloc_fold" as fold
    , "morloc_fold1" as fold1
    , "morloc_safeFold1" as safeFold1
    )

instance Functor Deque where
  source Cpp from "core.hpp" ("morloc_map" as map)

instance Stack Deque where
  source Cpp from "core.hpp"
    ( "morloc_cons" as cons
    , "morloc_uncons" as uncons
    )

instance Queue Deque where
  source Cpp from "core.hpp"
    ( "morloc_snoc" as snoc
    , "morloc_unsnoc" as unsnoc
    )

instance Semigroup (Deque a) where
  source Cpp from "core.hpp" ("morloc_list_add" as (<>))


-- Vector instances (same as List, both map to std::vector)
instance Foldable Vector where
  source Cpp from "core.hpp"
    ( "morloc_fold" as fold
    , "morloc_fold1" as fold1
    , "morloc_safeFold1" as safeFold1
    )

instance Functor Vector where
  source Cpp from "core.hpp" ("morloc_map" as map)

instance Indexed Vector where
  source Cpp from "core.hpp"
    ( "morloc_at" as at
    , "morloc_slice" as slice
    )

instance Queue Vector where
  source Cpp from "core.hpp"
    ( "morloc_snoc" as snoc
    , "morloc_unsnoc" as unsnoc
    )

instance Semigroup (Vector a) where
  source Cpp from "core.hpp" ("morloc_list_add" as (<>))


-- Array instances (same as List, both map to std::vector)
instance Foldable Array where
  source Cpp from "core.hpp"
    ( "morloc_fold" as fold
    , "morloc_fold1" as fold1
    , "morloc_safeFold1" as safeFold1
    )

instance Functor Array where
  source Cpp from "core.hpp" ("morloc_map" as map)

instance Indexed Array where
  source Cpp from "core.hpp"
    ( "morloc_at" as at
    , "morloc_slice" as slice
    )

instance Semigroup (Array a) where
  source Cpp from "core.hpp" ("morloc_list_add" as (<>))


instance Show a where
  show x = @show x

instance Readable a where
  read x = @read x

-------------------------------------------------------------------------------
--                 Pack and Unpack internal functions
-- These functions are used by morloc internally for (de)serialization of types
-- that cannot be automatically (de)serialized into/from JSON. They should not
-- be exported.
-------------------------------------------------------------------------------

instance Packable (Int) Unit where
  source Cpp from "data.hpp"
   ( "morloc_packUnit" as pack
   , "morloc_unpackUnit" as unpack
   )
