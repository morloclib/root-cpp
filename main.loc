instance Numeric Real where
  source Cpp from "core.hpp"
    ( "morloc_inv" as inv
    , "morloc_div" as (/)
    , "morloc_pow" as (**)
    , "morloc_ln" as ln
    )

instance Numeric Float32 where
  source Cpp from "core.hpp"
    ( "morloc_inv" as inv
    , "morloc_div" as (/)
    , "morloc_pow" as (**)
    , "morloc_ln" as ln
    )

